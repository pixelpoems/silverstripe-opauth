{
    "name": "pixelpoems/silverstripe-opauth",
    "type": "silverstripe-vendormodule",
    "description": "SilverStripe Opauth module for social login via OAuth. Community fork maintained by Pixelpoems.",
    "keywords": ["silverstripe", "social", "opauth", "oauth", "login"],
    "homepage": "https://github.com/pixelpoems/silverstripe-opauth",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Will Morgan",
            "homepage": "http://twitter.com/willmorgan",
            "role": "Original Developer"
        },
        {
            "name": "Dan Hensby",
            "homepage": "https://github.com/dhensby",
            "role": "Original Developer"
        },
        {
            "name": "Pixelpoems",
            "homepage": "https://github.com/pixelpoems",
            "role": "Fork Maintainer"
        }
    ],
    "require": {
        "silverstripe/framework": "~4.12",
        "opauth/opauth": "~0.4.5",
        "ext-http": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "~3.7"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dhensby/opauth"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
